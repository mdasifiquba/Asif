PORT=5000
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=storefly_db
DB_SSL=true
# OR provide full connection URL if provided by provider:
# DATABASE_URL=mysql://user:password@host:port/storefly_db
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
FRONTEND_URL=https://your-frontend-app.vercel.app
